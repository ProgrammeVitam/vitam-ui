        "_id": "PROFIL_" + tenant.identifier + "-COLLECT_APP-ARCHIVISTE_COLLECT_MANAGEMENT",
        "identifier": NumberInt(maxIdProfile++),
        "name": "Archiviste - gestion et collecte",
