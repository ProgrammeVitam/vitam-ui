        "hasTenantList": true,
        "hasHighlight": false,
        "tooltip": "Rechercher et consulter les archives",
        "target": "_self"
    }
);

dbIam.groups.updateOne(
    { "_id": "admin_group" },
    {
        $addToSet: {
            "profileIds": {
                $each: [
                    "system_archive_search_profile"
                ]
            }
