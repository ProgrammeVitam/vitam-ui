// Update every serviceId, making sure the regex is escaped ("." should be "\\." to prevent matching incorrect URLs, like for example https://sub-domain.com/ instead of https://sub.domain.com/)
dbCas.services.updateOne(
    { "_id": NumberInt(1) },
    {
        $set: {
            "serviceId": "{{ vitamui.ui_portal.serviceId | default('^' + vitamui.ui_portal.base_url | default(url_prefix) | regex_escape() | replace('\\', '\\\\') + '/.*') }}"
        }
    }
);
