// Create cas user

if (! dbCas.getUser("{{ mongodb.cas.user }}")) {
    dbCas.createUser(
        {
            user: "{{ mongodb.cas.user }}",
            pwd: "{{ mongodb.cas.password }}",
            roles: {{ mongodb.cas.roles }}
        }
    )
}
else {
    dbCas.updateUser(
        "{{ mongodb.cas.user }}",
        {
            pwd: "{{ mongodb.cas.password }}",
            roles: {{ mongodb.cas.roles }}
        }
    )
}
