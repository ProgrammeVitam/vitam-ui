db = db.getSiblingDB('iam');
dbSecurity = db.getSiblingDB('security')

print("START 007_add_role_get_filling_plan_access_on_archive_search.js");

// ---- ROLE_GET_FILLING_PLAN_ACCESS will be added to profiles on ARCHIVE_SEARCH_MANAGEMENT_APP --- //

db.profiles.updateMany({
   "applicationName": "ARCHIVE_SEARCH_MANAGEMENT_APP"
},
{
   "$addToSet": {
      "roles":{
           $each: [
              {
                "name":"ROLE_GET_FILLING_PLAN_ACCESS"
              }
          ]
      }
   }
});

dbSecurity.contexts.updateOne({
   "_id":"ui_archive_search_context"
},
{
   $addToSet: {
       "roleNames": "ROLE_GET_FILLING_PLAN_ACCESS"
   }
});

print("END 007_add_role_get_filling_plan_access_on_archive_search.js");
