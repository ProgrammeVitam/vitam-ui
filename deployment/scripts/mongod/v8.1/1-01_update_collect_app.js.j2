dbIam = db.getSiblingDB('{{ mongodb.iam.db | default('iam') }}')

dbIam.profiles.updateMany({
    applicationName: "COLLECT_APP"
}, {
    $addToSet: {
        roles: {
            $each: [
                { name: "ROLE_GET_UNITS" },
                { name: "ROLE_GET_AGENCIES" },
                { name: "ROLE_GET_ARCHIVE_PROFILES_UNIT" }
            ]
        }
    }
});

// Update previously migrated profiles, during upgrade to 8.0.0, to expected name
dbIam.profiles.updateMany(
  { name: "Archiviste-gestion et collecte" },
  { $set: { name: "Archiviste - gestion et collecte" } }
);

// We need a regex for newest profiles created from customer-init because it contains the tenantId...
dbIam.profiles.updateMany({
    applicationName: "COLLECT_APP",
    $or: [
        { name: { $regex: "^Archiviste - Administrateur" } },
        { name: { $regex: "^Archiviste - gestion et collecte" } }
    ]
}, {
    $addToSet: {
        roles: {
            $each: [
                { name: "ROLE_COLLECT_RECLASSIFICATION" },
                { name: "ROLE_COLLECT_DELETE_ARCHIVE_UNIT" }
            ]
        }
    }
});

dbSecurity = db.getSiblingDB('{{ mongodb.security.db | default('security') }}')
dbSecurity.contexts.updateOne({
    "_id": "ui_collect_context"
}, {
    $addToSet: {
        "roleNames": {
            $each: [
                "ROLE_GET_AGENCIES",
                "ROLE_GET_ARCHIVE_PROFILES_UNIT",
                "ROLE_COLLECT_RECLASSIFICATION",
                "ROLE_COLLECT_DELETE_ARCHIVE_UNIT"
            ]
        }
    }
});

