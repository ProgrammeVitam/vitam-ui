db = db.getSiblingDB('iam')
print("START_001_add_import_schema_role.js");
//add new roles ontology profile for system
db.profiles.updateMany({
        "_id": "system_ontology"
    },
    {
        $addToSet:{
            "roles":{
                $each: [
                    {"name":"ROLE_IMPORT_SCHEMAS"}
                ]
            }
        }
    });

db = db.getSiblingDB('security')
db.contexts.updateOne({
        "_id":"ui_referential_context"
    },
    {
        $addToSet:{
            "roleNames":{
                $each:[
                    "ROLE_IMPORT_SCHEMAS"
                ]
            }
        }
    });
print("END_001_add_import_schema_role.js");
