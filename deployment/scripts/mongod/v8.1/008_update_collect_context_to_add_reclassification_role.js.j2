dbSecurity = db.getSiblingDB("security");
dbIam = db.getSiblingDB("iam");

print("START 008_update_collect_context_to_add_reclassification_role.js");

dbSecurity.contexts.updateOne(
  {
    _id: "ui_collect_context",
  },
  {
    $addToSet: {
      roleNames: {
        $each: ["ROLE_COLLECT_RECLASSIFICATION"],
      },
    },
  },
);



dbIam.profiles.updateMany(
    { "applicationName": "COLLECT_APP",
     "name": { $in: ["Archiviste - Administrateur", "Archiviste - gestion et collecte"] }
    },
    { $addToSet: { "roles": { $each: [
                    { "name": "ROLE_COLLECT_RECLASSIFICATION" }
                ]}}}
);


print("END 008_update_collect_context_to_add_reclassification_role.js");
