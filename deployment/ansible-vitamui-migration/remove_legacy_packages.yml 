---

- hosts: localhost
  any_errors_fatal: true
  gather_facts: false
  vars_prompt:
    name: "confirmation"
    prompt: "This playbook will delete legacy vitamui binaries.\n\nAre you sure you want to run this playbook ?\nAnswer with 'YES'"
    default: "NO"
    private: false
  tasks:
    - name: Check Confirmation
      fail: msg="Playbook run confirmation failed"
      when: confirmation|upper != "YES"
      tags: always

- hosts: hosts_vitamui
  gather_facts: false
  tasks:
    - name: remove legacy vitamui packages
      package:
        name:
          - vitamui*
          - logstash
          - filebeat
          - mongodb*
          - consul
        state: absent

    - name: remove legacy configuration files
      file:
        path: "{{ item }}"
        state: absent
      with_items:
        - /vitam/conf/consul
        - /vitam/log/consul
        - /vitam/data/consul
