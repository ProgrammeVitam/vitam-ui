#jinja2: lstrip_blocks: True
server {

{% if vitamui_reverse_external_protocol | lower == 'https' %}
  listen {{ ip_service }}:{{ reverse_proxy_port }} ssl;
  include {{ nginx_ssl_dir }}/ssl.conf;
{% else %}
  listen {{ ip_service }}:{{ reverse_proxy_port }};
{% endif %}

  server_name {{ vitamui_reverse_external_dns }};

  location = /favicon.ico {
    alias {{ assets_path }}/favicon.ico;
  }

  # The pages of every application (identity, referential, ingest, pastis, archive-search, collect) and their APIs
  # (/<app>-api) are served by the single frontend application, i.e. by PORTAL below.

  # IDENTITY ADMIN API: relayed by the admin zone, with the certificate of its security context.
  location /identity-admin-api {
    proxy_pass {{ 'https' if vitamui.ui_identity_admin.secure | default(secure) | bool else 'http' }}://IDENTITY_ADMIN;
    include {{ nginx_conf_dir }}/proxy_params;
  }

{% if groups.get('hosts_ui_design_system', []) | length > 0 %}

  # DESIGN SYSTEM
  location /design-system {
    rewrite /design-system/(.*) /$1 break;
    proxy_pass http://DESIGN_SYSTEM;

    include {{ nginx_conf_dir }}/proxy_params;
  }
{% endif %}

  # CAS SERVER
  location = /cas {
    return 302 $scheme://$host/cas/login;
  }

  location ~ ^/cas/(login|logout|webjars|css|icons|favicon|images|js|serviceValidate|oauth2.0|clientredirect|oidc) {
    proxy_pass {{ 'https' if vitamui.cas_server.secure | default(secure) | bool else 'http' }}://CAS;
    include {{ nginx_conf_dir }}/proxy_params;
  }

  # PORTAL (the single frontend application)
  location / {
    proxy_pass {{ 'https' if vitamui.ui_portal.secure | default(secure) | bool else 'http' }}://PORTAL;
    include {{ nginx_conf_dir }}/proxy_params;
  }

  # Uploads of ingest and collect: the request body is streamed to the API, whatever its size, with long timeouts.
  location ~ ^/(ingest|collect)-api/ {
    proxy_pass {{ 'https' if vitamui.ui_portal.secure | default(secure) | bool else 'http' }}://PORTAL;
    include {{ nginx_conf_dir }}/proxy_params;
    proxy_request_buffering off;
    client_max_body_size 0;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
  }

}
