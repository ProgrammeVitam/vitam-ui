#jinja2: lstrip_blocks: True
##################################################################
# UPSTREAM DEFINITION == PER 'HOSTS-*' ZONE + PER APPLICATION PORT
##################################################################

# VITAMUI

upstream IDENTITY_ADMIN {
  ip_hash;
{% for h in groups['hosts_ui_identity_admin'] %}
  server {{ hostvars[h].ip_service }}:{{ vitamui.ui_identity_admin.port_service }};
{% endfor %}
}

upstream CAS {
  ip_hash;
{% for h in groups['hosts_cas_server'] %}
  server {{ hostvars[h].ip_service }}:{{ vitamui.cas_server.port_service }};
{% endfor %}
}

upstream PORTAL {
  ip_hash;
{% for h in groups['hosts_ui_portal'] %}
  server {{ hostvars[h].ip_service }}:{{ vitamui.ui_portal.port_service }};
{% endfor %}
}

{% if groups.get('hosts_ui_design_system', []) | length > 0 %}

upstream DESIGN_SYSTEM {
  ip_hash;
  {% for h in groups['hosts_ui_design_system'] %}
  server {{ hostvars[h].ip_service }}:{{ vitamui.ui_design_system.port_service }};
  {% endfor %}
}
{% endif %}
