    # UI ARCHIVE SEARCH
    ProxyPassMatch ^/archive-search/(.*)$ {{ 'https' if vitamui.ui_archive_search.secure | default(secure) | bool else 'http' }}://vitamui-{{ vitamui.ui_archive_search.vitamui_component }}.service.{{ consul_domain }}:{{ vitamui.ui_archive_search.port_service }}/$1
    ProxyPassReverse /archive-search {{ 'https' if vitamui.ui_archive_search.secure | default(secure) | bool else 'http' }}://vitamui-{{ vitamui.ui_archive_search.vitamui_component }}.service.{{ consul_domain }}:{{ vitamui.ui_archive_search.port_service }}
