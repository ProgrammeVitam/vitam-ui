    ProxyPassReverse /pastis {{ 'https' if vitamui.ui_pastis.secure | default(secure) | bool else 'http' }}://vitamui-{{ vitamui.ui_pastis.vitamui_component }}.service.{{ consul_domain }}:{{ vitamui.ui_pastis.port_service }}
