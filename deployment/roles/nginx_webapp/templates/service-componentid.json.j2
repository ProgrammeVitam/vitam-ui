{
  "service": {
    "name": "vitamui-{{ vitamui_struct.vitamui_component }}",
    "address": "{{ ip_service }}",
    "port": {{ vitamui_struct.port_service }},
    "enable_tag_override": false,
    "tags": ["vitamui", "{{ vitamui_struct.vitamui_component }}"],
    "checks": [
      {
        "name": "Service 'vitamui-{{ vitamui_struct.vitamui_component }}' check",
        "notes": "HTTP port opened",
        "tcp": "{{ ip_service }}:{{ vitamui_struct.port_service }}",
        "interval": "10s"
      }
    ]
  }
}
