#jinja2: lstrip_blocks: True
spring:
  application:
    name: vitamui-{{ vitamui_struct.vitamui_component }}
  cloud:
    consul:
      enabled: true
      host: {{ hostvars[inventory_hostname][consul.network] if (inventory_hostname in groups['hosts_vitamui_consul_server'] or inventory_hostname in groups['hosts_consul_server']) else 'localhost' }}
      discovery:
        serviceName: ${spring.application.name}
        preferIpAddress: true
        ipAddress: ${server.address}
        healthCheckUrl: http://${management.server.address}:${management.server.port}/actuator/health
        tags: vitamui, {{ vitamui_struct.vitamui_component }}
        instanceId: ${spring.application.name}-${spring.cloud.client.hostname}-${server.port}
  servlet:
    multipart:
      max-file-size: -1
      max-request-size: -1
cas.tenant.identifier: {{ vitamui_platform_informations.cas_tenant }}
logging:
  config: {{ vitamui_folder_conf }}/logback.xml
  level:
    fr.gouv.vitamui.referential.server: {{ vitamui_struct.log.vitamui_level | default(log.vitamui_level) }}

server:
  address: {{ ip_service }}
  port: {{ vitamui_struct.port_service }}
{% if vitamui_struct.secure | default(secure) | bool == true %}
  ssl:
    key-store: {{ vitamui_folder_conf }}/keystore_{{ vitamui_struct.service_name | default(service_name) }}.jks
    key-store-password: {{ password_keystore_server }}
    key-password: {{ password_keystore_server }}
    trust-store: {{ vitamui_folder_conf }}/truststore_{{ vitamui_certificate_type }}.jks
    trust-store-password: {{ password_truststore }}
    client-auth: want
    client-certificate-header-name: {{ vitamui.api_gateway.client_certificate_header_name | default('x-ssl-cert') }}
{% endif %}

  error:
    path: /error
  max-http-request-header-size: {{ vitamui_struct.server_max_http_header_size | default('10KB') }}
  tomcat:
    connection-timeout: {{ vitamui_struct.server_connection_timeout }}
    accesslog:
      enabled: {{ vitamui_struct.accesslogs | default(accesslogs) | lower }}
      max-days: {{ vitamui_struct.access_retention_days | default(access_retention_days) }}
      directory: "{{ vitamui_folder_log }}"
      prefix: "accesslog-{{ vitamui_struct.vitamui_component}}"
      file-date-format: ".yyyy-MM-dd"
      suffix: ".log"

management:
  server:
    address: {{ ip_admin }}
    port: {{ vitamui_struct.port_admin }}
    ssl:
      enabled: false
  endpoints:
    web:
      exposure:
        include: health,metrics,prometheus
  metrics:
    tags:
      application: ${spring.application.name}

gateway:
  enabled: true

referential:
  security-client:
    server-host: {{ vitamui.security.host }}
    server-port: {{ vitamui.security.port_service }}
{% if vitamui.security.secure | default(secure) | bool == true %}
    secure: {{ vitamui.security.secure | default(secure) | lower }}
    ssl-configuration:
      truststore:
        key-path: {{ vitamui_folder_conf }}/truststore_{{ vitamui_certificate_type }}.jks
        key-password: {{ password_truststore }}
      hostname-verification: true
{% endif %}
  iam-client:
    server-host: {{ vitamui.iam.host }}
    server-port: {{ vitamui.iam.port_service }}
{% if vitamui.iam.secure | default(secure) | bool == true %}
    secure: {{ vitamui.iam.secure | default(secure) | lower }}
    ssl-configuration:
      keystore:
        key-path: {{ vitamui_folder_conf }}/keystore_client_{{ vitamui_struct.service_name | default(service_name) }}.jks
        key-password: {{ password_keystore_client }}
        type: JKS
      truststore:
        key-path: {{ vitamui_folder_conf }}/truststore_{{ vitamui_certificate_type }}.jks
        key-password: {{ password_truststore }}
      hostname-verification: true
{% endif %}

{% if external_archiving_systems is defined %}
  # Connection settings for external / third-party Vitam instances (for COLLECT)
  external-archiving-system-clients:
  {% if external_archiving_systems.client_configuration | default([]) is iterable %}
    {% for clientConfig in external_archiving_systems.client_configuration | default([]) %}
    - archiving-system-id: {{ clientConfig.archiving_system_id }}
      name: {{ clientConfig.name }}
      access-external-client:
        server-host: {{ clientConfig.access_external.host }}
        server-port: {{ clientConfig.access_external.port }}
        secure: true
        ssl-configuration:
          keystore:
            key-path: {{ vitamui_folder_conf }}/keystore_external_archiving_system_{{ clientConfig.archiving_system_id }}.p12
            key-password: {{ external_archiving_systems.keystore_password[clientConfig.archiving_system_id] }}
          truststore:
            key-path: {{ vitamui_folder_conf }}/truststore_external_archiving_system_{{ clientConfig.archiving_system_id }}.jks
            key-password: {{ external_archiving_systems.truststore_password[clientConfig.archiving_system_id] }}
    {% endfor %}
  {% endif %}

  # Access to other tenants and/or third party Vitam instances
  external-archiving-system-tenants:
  {% if external_archiving_systems.tenant_configuration | default([]) is iterable %}
    {% for tenantConfig in external_archiving_systems.tenant_configuration | default([]) %}
    - tenant: {{ tenantConfig.tenant }}
      external-archiving-system-references:
      {% if tenantConfig.external_archiving_system_references | default([]) is iterable %}
        {% for referenceConf in tenantConfig.external_archiving_system_references | default([]) %}
        - archiving_system_id: {{ referenceConf.archiving_system_id }}
          tenantIds: {{ referenceConf.tenantIds }}
        {% endfor %}
      {% endif %}
    {% endfor %}
  {% endif %}

{% endif %}

internal_ontology_file_path: {{ vitamui_folder_data }}/internal_ontology_fields.json

{% if opentracing.jaeger.enabled | default(false) | bool %}
opentracing:
  jaeger:
    enabled: {{ opentracing.jaeger.enabled }}
    logSpans: {{ opentracing.jaeger.log_spans }}
    expandExceptionLogs: {{ opentracing.jaeger.expand_exception_logs }}
    udp-sender:
      host: {{ opentracing.jaeger.udp_sender.host }}
      port: {{ opentracing.jaeger.udp_sender.port }}
{% endif %}
