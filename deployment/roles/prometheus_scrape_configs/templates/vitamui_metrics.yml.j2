#jinja2: lstrip_blocks: True
scrape_configs:
{% if groups['hosts_vitamui_api_gateway'] | default([]) | length > 0 %}

  - job_name: vitamui-api-gateway
    metrics_path: {{ vitamui.api_gateway.metrics_path | default(default_prometheus_metrics_path) }}
    static_configs:
      - targets:
        {% for host in groups['hosts_vitamui_api_gateway'] %}
        - {{ hostvars[host]['ip_admin'] }}:{{ vitamui.api_gateway.port_admin }}
      {% endfor %}
{% endif %}
