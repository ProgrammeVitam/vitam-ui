<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>iam-auth-contract</artifactId>
    <packaging>jar</packaging>
    <name>VITAMUI IAM Authentication Contract</name>
    <description>
        Contrat d'authentification exposé par IAM : les DTO et les chemins que consomme un serveur
        d'authentification. Ce module ne dépend ni de pac4j, ni d'iam-commons — il ne porte que le
        contrat, jamais le modèle d'administration ni la logique de protocole.
    </description>

    <parent>
        <groupId>fr.gouv.vitamui</groupId>
        <artifactId>api-iam</artifactId>
        <version>10.0.0-SNAPSHOT</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- UTIL -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Le contrat ne vaut que par ce qu'il ne contient pas. Une dépendance ajoutée par
                inadvertance vers iam-commons ou vers pac4j rendrait sa consommation aussi lourde que
                celle d'IAM en entier, sans que rien ne le signale : le build échoue à la place.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-administration-and-protocol-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>fr.gouv.vitamui:iam-commons</exclude>
                                        <exclude>fr.gouv.vitamui:iam-client</exclude>
                                        <exclude>org.pac4j:*</exclude>
                                        <exclude>org.apereo.cas:*</exclude>
                                        <exclude>org.springframework.data:*</exclude>
                                    </excludes>
                                    <message>
                                        iam-auth-contract ne porte que le contrat d'authentification : ni le modèle
                                        d'administration d'IAM, ni la logique de protocole, ni l'accès aux données.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
