<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.gouv.vitamui</groupId>
    <version>10.0.0-SNAPSHOT</version>
    <artifactId>cas</artifactId>
    <packaging>pom</packaging>
    <name>VITAMUI CAS</name>

    <properties>
        <spotless-maven-plugin.version>2.43.0</spotless-maven-plugin.version>
        <spotless.check.skip>true</spotless.check.skip>
        <pitest-maven-plugin.version>1.30.1</pitest-maven-plugin.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    </properties>

    <modules>
        <module>cas-server</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            This profile is used to run mutation testing with PIT (https://pitest.org/).
            CAS does not inherit from the root pom: keep this profile in sync with the "pitest" profile of the root pom
            (except for target classes and tests).
        -->
        <profile>
            <id>pitest</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven-plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!--
                                Restricted to CAS packages: in a full reactor build, the classes of the other vitam-ui
                                modules (built with Spring Boot 4) are on the classpath and make the PIT minion crash.
                            -->
                            <targetClasses>
                                <param>fr.gouv.vitamui.cas.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>fr.gouv.vitamui.cas.*</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>*IT</param>
                                <param>*IntegrationTest</param>
                            </excludedTestClasses>
                            <outputFormats>
                                <format>HTML</format>
                                <format>XML</format>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <threads>4</threads>
                            <!-- Some modules have no tests or no mutable code: do not fail the build for them -->
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <skipFailingTests>true</skipFailingTests>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pitest</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!-- Profile to use for all Vitam internal developers -->
            <id>vitam</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <!-- Dépôts Maven privés -->
            <distributionManagement>
                <repository>
                    <id>vitam-releases</id>
                    <name>Vitam release repository</name>
                    <url>${env.SERVICE_NEXUS_URL}/repository/maven-releases/</url>
                </repository>
                <snapshotRepository>
                    <id>vitam-snapshots</id>
                    <name>Vitam SNAPSHOT repository</name>
                    <url>${env.SERVICE_NEXUS_URL}/repository/maven-snapshots/</url>
                </snapshotRepository>
                <site>
                    <id>${project.artifactId}-site</id>
                    <url>${project.baseUri}</url>
                </site>
            </distributionManagement>

            <repositories>
                <repository>
                    <id>vitam-releases</id>
                    <name>Vitam release repository</name>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                    <url>${env.SERVICE_NEXUS_URL}/repository/maven-releases/</url>
                </repository>
                <repository>
                    <id>vitam-snapshots</id>
                    <name>Vitam SNAPSHOT repository</name>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <url>${env.SERVICE_NEXUS_URL}/repository/maven-snapshots/</url>
                </repository>
            </repositories>

            <properties>
                <serverId>vitam</serverId>
                <downloadRoot>${env.SERVICE_NEXUS_URL}/repository/node-distrib/</downloadRoot>
            </properties>
        </profile>
    </profiles>
</project>
