{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  // The karma plugin evaluates karma.conf.js outside of the Angular builder, where
  // config.buildWebpack is undefined. The Angular plugin already adds the Karma
  // configuration of angular.json (karma.conf.ci.js, which requires karma.conf.js)
  // as an entry, so their require() calls still mark the karma-* plugins as used.
  "karma": false,
  // proxy.conf.js is passed to "ng serve --proxy-config" by the "start" script.
  "entry": ["proxy.conf.js"],
  "rules": {
    // Enums mirror backend contracts (roles, statuses, action types) and some are
    // iterated with Object.values(), which knip does not see (e.g. PreservationUsage).
    "enumMembers": "off"
  },
  "husky": {
    "config": ["../../.husky/pre-commit"]
  },
  "ignoreDependencies": [
    // ESLint plugins and parsers loaded by name through FlatCompat in eslint.config.mjs.
    "@angular-eslint/eslint-plugin",
    "@angular-eslint/eslint-plugin-template",
    "@angular-eslint/template-parser",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    // Schematic collection declared in angular.json (cli.schematicCollections).
    "@angular-eslint/schematics",
    // Imported from SCSS (@use), which knip does not analyse.
    "bootstrap",
    "material-design-icons-iconfont"
  ]
}
