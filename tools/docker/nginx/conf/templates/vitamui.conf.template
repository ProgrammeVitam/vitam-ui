## VitamUI dev reverse proxy — single origin, as in deployed environments:
## portal at /, other apps under /<app>/, /<app>-api/ -> api-gateway (mTLS),
## /cas/ -> cas-server. Merges the two production nginx layers (roles/reverse
## and roles/nginx_webapp) into one instance.
##
## Each application is served LIVE from its Angular dev server when one is
## running (`npm run start:<app>`), with an automatic fallback on its dist/
## otherwise — no command to run, no configuration to toggle. API calls are
## always routed by nginx to the api-gateway, live or not.

## Angular dev-server port per application (ui/ui-frontend/angular.json).
## The test suite overrides these to point at its stubs.
map $vitamui_app $vitamui_ng_port {
    "identity"        ${VITAMUI_NG_PORT_IDENTITY};
    "referential"     ${VITAMUI_NG_PORT_REFERENTIAL};
    "ingest"          ${VITAMUI_NG_PORT_INGEST};
    "archive-search"  ${VITAMUI_NG_PORT_ARCHIVE_SEARCH};
    "collect"         ${VITAMUI_NG_PORT_COLLECT};
    "pastis"          ${VITAMUI_NG_PORT_PASTIS};
    "design-system"   ${VITAMUI_NG_PORT_DESIGN_SYSTEM};
}

## HTTP -> HTTPS redirect.
server {
    listen      ${VITAMUI_HTTP_PORT};
    server_name ${VITAMUI_SERVER_NAME};

    return 301 ${VITAMUI_PUBLIC_ORIGIN}$request_uri;
}

server {
    listen      ${VITAMUI_HTTPS_PORT} ssl;
    http2       on;
    server_name ${VITAMUI_SERVER_NAME};

    include /etc/nginx/snippets/ssl.conf;

    ## Angular dist/ root, one subdirectory per app.
    root /usr/share/nginx/html/vitamui;

    ## Local probe — hits no upstream. Used by tests and the docker healthcheck.
    location = /__vitamui/health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP","component":"vitamui-dev-reverse"}';
    }

    ## 1. APIs -> api-gateway (mTLS). Declared first: regex locations are
    ## evaluated in file order, so /<app>-api must match before /<app>. This
    ## also keeps API calls on nginx in live mode: the Angular dev server
    ## never sees them. Variables in proxy_ssl_certificate require
    ## nginx >= 1.21.0.

    ## 1a. Absolute form /<app>-api/... (the portal's BASE_URL).
    location ~ "^/(portal|identity|referential|ingest|archive-search|collect|pastis)-api(?:/|$)" {
        set $vitamui_api $1;

        proxy_pass https://${VITAMUI_GATEWAY};

        include /etc/nginx/snippets/api-gateway.conf;
    }

    ## 1b. Form relative to the <base href>: /<app>/<app>-api/... Apps other
    ## than the portal declare a RELATIVE BASE_URL, so served under
    ## <base href="/<app>/"> their calls repeat the prefix. Strip the first
    ## segment, as prod's roles/reverse does; the \1 backreference restricts
    ## the stripping to the app's own API, as in prod.
    location ~ "^/(identity|referential|ingest|archive-search|collect|pastis)/(\1-api(?:/.*)?)$" {
        ## Set variables BEFORE the rewrite: it resets positional captures.
        set $vitamui_api  $1;
        set $vitamui_tail $2;

        rewrite ^ /$vitamui_tail break;

        proxy_pass https://${VITAMUI_GATEWAY};

        include /etc/nginx/snippets/api-gateway.conf;
    }

    ## 2. CAS. cas-server already carries the /cas context-path, so the URI is
    ## passed unchanged (proxy_pass without a URI part preserves $request_uri).
    location = /cas {
        return 302 ${VITAMUI_PUBLIC_ORIGIN}/cas/login;
    }

    location /cas/ {
        proxy_pass https://${VITAMUI_CAS};

        proxy_ssl_verify      off;
        proxy_ssl_server_name on;

        include /etc/nginx/snippets/proxy_params.conf;
    }

    ## 3. Static assets. Declared before the app locations so, in dist mode, a
    ## missing asset returns 404 instead of falling back to index.html. Two
    ## separate blocks, with no cross-app fallback: an app must never be
    ## served another app's files.
    ##
    ## Live first: the request is proxied to the app's Angular dev server; a
    ## 502 generated by nginx itself (connection refused: no dev server) falls
    ## back to the dist. A real dev-server response — including an error while
    ## it recompiles — is never intercepted.

    ## App assets, referenced under /<app>/ (--deploy-url).
    location ~* "^/(identity|referential|ingest|archive-search|collect|pastis|design-system)(/.+\.(?:js|mjs|css|map|json|ico|png|jpe?g|gif|svg|webp|webmanifest|woff2?|ttf|eot))$" {
        set $vitamui_app  $1;
        set $vitamui_path $2;

        error_page 502 = @app_assets_dist;
        include /etc/nginx/snippets/ng-serve-proxy.conf;
        proxy_pass https://127.0.0.1:$vitamui_ng_port;
    }

    ## The browser/ fallback covers the Angular >= 17 dist layout next to the
    ## flat one.
    location @app_assets_dist {
        include /etc/nginx/snippets/spa.conf;

        try_files $uri /$vitamui_app/browser$vitamui_path =404;
    }

    ## Portal assets, referenced from the root (built without --base-href).
    ## (?!/cas/) leaves cas-server its own assets, handled above.
    location ~* "^(?!/cas/)(/.+\.(?:js|mjs|css|map|json|ico|png|jpe?g|gif|svg|webp|webmanifest|woff2?|ttf|eot))$" {
        set $vitamui_path $1;

        error_page 502 = @portal_assets_dist;
        include /etc/nginx/snippets/ng-serve-proxy.conf;
        proxy_pass https://127.0.0.1:${VITAMUI_NG_PORT_PORTAL};
    }

    location @portal_assets_dist {
        root /usr/share/nginx/html/vitamui/portal;

        include /etc/nginx/snippets/spa.conf;

        try_files $uri /browser$vitamui_path =404;
    }

    ## 4. Angular apps (except portal): live first, dist fallback.
    location ~ "^/(identity|referential|ingest|archive-search|collect|pastis|design-system)(/.*)?$" {
        set $vitamui_app  $1;
        set $vitamui_path $2;

        error_page 502 = @app_dist;
        include /etc/nginx/snippets/ng-serve-proxy.conf;
        proxy_pass https://127.0.0.1:$vitamui_ng_port;
    }

    ## Deep routes fall back to the app's index.html. The final =404 makes all
    ## candidates be tested as files: a missing dist/ then returns 404 instead
    ## of a 500 redirection cycle. No $uri/ either (a missing index.html would
    ## yield a misleading 403). The browser/ candidates cover the Angular >= 17
    ## layout.
    location @app_dist {
        include /etc/nginx/snippets/spa.conf;

        try_files $uri
                  /$vitamui_app/browser$vitamui_path
                  /$vitamui_app/index.html
                  /$vitamui_app/browser/index.html
                  =404;
    }

    ## 5. Portal, at the root (built without --base-href): live first, dist
    ## fallback.
    location / {
        error_page 502 = @portal_dist;
        include /etc/nginx/snippets/ng-serve-proxy.conf;
        proxy_pass https://127.0.0.1:${VITAMUI_NG_PORT_PORTAL};
    }

    ## Same rationale as @app_dist for =404 and the browser/ candidates.
    location @portal_dist {
        root /usr/share/nginx/html/vitamui/portal;

        include /etc/nginx/snippets/spa.conf;

        try_files $uri /browser$uri /index.html /browser/index.html =404;
    }
}
