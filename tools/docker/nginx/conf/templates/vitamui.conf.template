## VitamUI dev reverse proxy — single origin, as in deployed environments:
## the single frontend application (project `portal`) at / with every feature
## (/identity, /referential, /ingest...) as one of its routes, the design
## system under /design-system/, /<app>-api/ -> api-gateway (mTLS), /cas/ ->
## cas-server. Merges the two production nginx layers (roles/reverse and
## roles/nginx_webapp) into one instance.
##
## Each application is served LIVE from its Angular dev server when one is
## running (`npm run start:vitamui`, `npm run start:design-system`), with an
## automatic fallback on its dist/ otherwise — no command to run, no
## configuration to toggle. API calls are always routed by nginx to the
## api-gateway, live or not.

## HTTP -> HTTPS redirect.
server {
    listen      ${VITAMUI_HTTP_PORT};
    server_name ${VITAMUI_SERVER_NAME};

    return 301 ${VITAMUI_PUBLIC_ORIGIN}$request_uri;
}

server {
    listen      ${VITAMUI_HTTPS_PORT} ssl;
    http2       on;
    server_name ${VITAMUI_SERVER_NAME};

    include /etc/nginx/snippets/ssl.conf;

    ## Angular dist/ root, one subdirectory per app.
    root /usr/share/nginx/html/vitamui;

    ## Local probe — hits no upstream. Used by tests and the docker healthcheck.
    location = /__vitamui/health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP","component":"vitamui-dev-reverse"}';
    }

    ## 1. APIs -> api-gateway (mTLS), one client certificate per API, as
    ## deployment/roles/nginx_webapp (frontend_apis.ui-portal). Declared first:
    ## regex locations are evaluated in file order, so /<app>-api must match
    ## before the application routes. This also keeps API calls on nginx in
    ## live mode: the Angular dev server never sees them. Variables in
    ## proxy_ssl_certificate require nginx >= 1.21.0.
    location ~ "^/(portal|identity|referential|ingest|archive-search|collect|pastis)-api(?:/|$)" {
        set $vitamui_api $1;

        proxy_pass https://${VITAMUI_GATEWAY};

        include /etc/nginx/snippets/api-gateway.conf;
    }

    ## The identity administration feature (/identity-admin) calls the
    ## identity API with the certificate of the admin security context; the
    ## gateway only knows /identity-api (frontend_apis.ui-identity-admin).
    location ~ "^/identity-admin-api(/.*)?$" {
        set $vitamui_api  identity-admin;
        set $vitamui_tail $1;

        rewrite ^ /identity-api$vitamui_tail break;

        proxy_pass https://${VITAMUI_GATEWAY};

        include /etc/nginx/snippets/api-gateway.conf;
    }

    ## 2. CAS. cas-server already carries the /cas context-path, so the URI is
    ## passed unchanged (proxy_pass without a URI part preserves $request_uri).
    location = /cas {
        return 302 ${VITAMUI_PUBLIC_ORIGIN}/cas/login;
    }

    location /cas/ {
        proxy_pass https://${VITAMUI_CAS};

        proxy_ssl_verify      off;
        proxy_ssl_server_name on;

        include /etc/nginx/snippets/proxy_params.conf;
    }

    ## Live first, everywhere below: the request is proxied to the app's
    ## Angular dev server; a 502 generated by nginx itself (connection
    ## refused: no dev server) falls back to the dist. A real dev-server
    ## response — including an error while it recompiles — is never
    ## intercepted.

    ## 3. Design system, under /design-system/ (--base-href and --deploy-url,
    ## servePath in angular.json), from its own dist, never the portal's.

    ## Its assets first: in dist mode a missing asset returns 404 instead of
    ## falling back to index.html.
    location ~* "^/design-system(/.+\.(?:js|mjs|css|map|json|ico|png|jpe?g|gif|svg|webp|webmanifest|woff2?|ttf|eot))$" {
        set $vitamui_path $1;

        error_page 502 = @design_system_assets_dist;
        include /etc/nginx/snippets/ng-serve-proxy.conf;
        proxy_pass https://127.0.0.1:${VITAMUI_NG_PORT_DESIGN_SYSTEM};
    }

    ## The browser/ fallback covers the Angular >= 17 dist layout next to the
    ## flat one.
    location @design_system_assets_dist {
        include /etc/nginx/snippets/spa.conf;

        try_files $uri /design-system/browser$vitamui_path =404;
    }

    location ~ "^/design-system(/.*)?$" {
        set $vitamui_path $1;

        error_page 502 = @design_system_dist;
        include /etc/nginx/snippets/ng-serve-proxy.conf;
        proxy_pass https://127.0.0.1:${VITAMUI_NG_PORT_DESIGN_SYSTEM};
    }

    ## Deep routes fall back to index.html. The final =404 makes all
    ## candidates be tested as files: a missing dist/ then returns 404 instead
    ## of a 500 redirection cycle. No $uri/ either (a missing index.html would
    ## yield a misleading 403).
    location @design_system_dist {
        include /etc/nginx/snippets/spa.conf;

        try_files $uri
                  /design-system/browser$vitamui_path
                  /design-system/index.html
                  /design-system/browser/index.html
                  =404;
    }

    ## 4. Portal assets, referenced from the root (built without --base-href).
    ## Declared before the routes so, in dist mode, a missing asset returns
    ## 404 instead of falling back to index.html. (?!/cas/) leaves cas-server
    ## its own assets, handled above.
    location ~* "^(?!/cas/)(/.+\.(?:js|mjs|css|map|json|ico|png|jpe?g|gif|svg|webp|webmanifest|woff2?|ttf|eot))$" {
        set $vitamui_path $1;

        error_page 502 = @portal_assets_dist;
        include /etc/nginx/snippets/ng-serve-proxy.conf;
        proxy_pass https://127.0.0.1:${VITAMUI_NG_PORT_PORTAL};
    }

    location @portal_assets_dist {
        root /usr/share/nginx/html/vitamui/portal;

        include /etc/nginx/snippets/spa.conf;

        try_files $uri /browser$vitamui_path =404;
    }

    ## 5. Portal, at the root: its own pages and every feature route
    ## (/identity, /identity-admin, /referential, /ingest, /archive-search,
    ## /collect, /pastis, /account...) — deep routes included.
    location / {
        error_page 502 = @portal_dist;
        include /etc/nginx/snippets/ng-serve-proxy.conf;
        proxy_pass https://127.0.0.1:${VITAMUI_NG_PORT_PORTAL};
    }

    ## Same rationale as @design_system_dist for =404 and the browser/
    ## candidates.
    location @portal_dist {
        root /usr/share/nginx/html/vitamui/portal;

        include /etc/nginx/snippets/spa.conf;

        try_files $uri /browser$uri /index.html /browser/index.html =404;
    }
}
