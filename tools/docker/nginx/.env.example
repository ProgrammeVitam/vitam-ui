## Dev reverse proxy overrides. Copy to .env (git-ignored).

## Must resolve to 127.0.0.1 (/etc/hosts) and be covered by the
## servers/reverse certificate (CN=dev.vitamui.com, SAN + localhost).
#VITAMUI_SERVER_NAME=dev.vitamui.com

## Public origin used for redirects; include the port if not 443.
#VITAMUI_PUBLIC_ORIGIN=https://dev.vitamui.com

## Listen ports. Above 1024 avoids privileges, but the port must then appear
## in VITAMUI_PUBLIC_ORIGIN and in the frontends' config-dev.json.
#VITAMUI_HTTP_PORT=80
#VITAMUI_HTTPS_PORT=443

## Upstreams (host:port), resolved at configuration load time.
#VITAMUI_GATEWAY=127.0.0.1:8070
#VITAMUI_CAS=127.0.0.1:8080

## Angular dist/ directory (one subdirectory per app); relative to the
## docker-compose.yml, or absolute.
#VITAMUI_DIST_DIR=../../../ui/ui-frontend/dist

## Dev certificates directory (ca/ clients/ servers/ tree).
#VITAMUI_CERTS_DIR=../../../dev-deployment/environments/certs/vitamui-services

## Angular dev-server ports (ui/ui-frontend/angular.json). An app whose dev
## server answers on its port is served live, otherwise from its dist/.
#VITAMUI_NG_PORT_PORTAL=4200
#VITAMUI_NG_PORT_IDENTITY=4201
#VITAMUI_NG_PORT_REFERENTIAL=4202
#VITAMUI_NG_PORT_INGEST=4208
#VITAMUI_NG_PORT_ARCHIVE_SEARCH=4209
#VITAMUI_NG_PORT_COLLECT=4210
#VITAMUI_NG_PORT_DESIGN_SYSTEM=4242
#VITAMUI_NG_PORT_PASTIS=4251
