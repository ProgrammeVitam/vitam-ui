    },
    {
      "username": "demo.saml@keycloak-saml.fr",
      "email": "demo.saml@keycloak-saml.fr",
      "firstName": "Demo",
      "lastName": "SAML",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ChangeIt.2024",
          "temporary": false
        }
      ]
    }
  ]
