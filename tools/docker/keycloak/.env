# Configuration of the Keycloak test IdP (OIDC + SAML) and of its wiring into VitamUI.
# Everything below is read both by docker compose and by ./setup.sh.

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
KEYCLOAK_VERSION=26.1
KEYCLOAK_HTTP_PORT=8042
# URL through which BOTH the browser and the CAS server reach Keycloak.
# It is embedded in the OIDC discovery document and in the SAML metadata, so it
# must be identical on both sides.
KEYCLOAK_BASE_URL=http://localhost:8042
KEYCLOAK_REALM=vitamui
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# OIDC client registered in the realm (mirrored into the VitamUI provider).
OIDC_CLIENT_ID=vitamui-oidc
OIDC_CLIENT_SECRET=UOOtWLQjkFEcRnbAyNlEuZeaTMSDqLNK

# ---------------------------------------------------------------------------
# VitamUI
# ---------------------------------------------------------------------------
# Public URL of the CAS server. Used to compute the OIDC redirect URI, the SAML
# service provider entityId and the SAML assertion consumer service URL.
VITAMUI_CAS_URL=https://dev.vitamui.com:8080/cas

# technicalName of each provider in the iam.providers collection. It ends up in
# the `client_name` query parameter of the CAS callback, so it must match on
# both sides — ./setup.sh keeps Keycloak aligned with these values.
OIDC_TECHNICAL_NAME=keycloak-oidc
SAML_TECHNICAL_NAME=keycloak-saml

# Email domains routed to each provider. One domain per provider: within a
# single customer, VitamUI picks the FIRST provider whose pattern matches, so
# overlapping domains would make one of the two unreachable.
OIDC_EMAIL_DOMAIN=keycloak-oidc.fr
SAML_EMAIL_DOMAIN=keycloak-saml.fr

# Test accounts. They exist in Keycloak *and* in the VitamUI organization:
# delegated authentication does not create anything, the user must already exist
# on both sides with the same email. ./setup.sh realigns both sides on the values
# below, so changing one of them and re-running is enough.
OIDC_USER_EMAIL=demo.oidc@keycloak-oidc.fr
SAML_USER_EMAIL=demo.saml@keycloak-saml.fr
IDP_USER_PASSWORD=ChangeIt.2024

# The VitamUI organization the two providers are attached to. By default it is
# resolved from an existing user, so the script adapts to any dataset; set
# VITAMUI_CUSTOMER_ID / VITAMUI_GROUP_ID to pin it explicitly.
VITAMUI_REFERENCE_USER_EMAIL=admin@change-it.fr
VITAMUI_CUSTOMER_ID=
VITAMUI_GROUP_ID=

# Addresses Keycloak accepts to send the browser back to after a logout. CAS ends the
# logout on the application the user came from, so the app urls must be listed here.
# "+" keeps the client redirect uris, further values are separated by "##". Add an entry
# per application tested (identity 4201, referential 4202...).
VITAMUI_POST_LOGOUT_REDIRECT_URIS=+##https://dev.vitamui.com:4200/*

# Mongo instance holding the iam database (tools/docker/mongo default).
MONGO_URI=mongodb://mongod_dbuser_iam:mongod_dbpwd_iam@localhost:27018/iam?directConnection=true
MONGO_DB=iam

# Password of the generated SAML service provider keystore.
SP_KEYSTORE_PASSWORD=changeit
